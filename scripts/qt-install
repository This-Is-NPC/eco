#!/usr/bin/env python3
"""Install the Qt that eco builds with, through aqt, which mise pins. Qt `QT`,
its base and declarative modules (everything the overlay
imports), into the checkout under .qt/<QT>/<folder>:
- Windows: MSVC 2022 64-bit, msvc2022_64, for eco-window.
- macOS: macos, for eco-window.
- Linux: android_x86_64, the Qt for Android, and gcc_64, the desktop Qt that
  holds its host tools (androiddeployqt, qsb, moc). eco-window on Linux still
  builds with the system's Qt.
Removes any other Qt version there. Idempotent: each target has its own file
that tells it is whole, a target already installed is left alone, and none
removes another."""

import os
import shutil
import subprocess
import sys
from pathlib import Path

QT = "6.11.2"
ARCHIVES = ["qtbase", "qtdeclarative"]
# Per platform, the targets to install: the aqt host, the aqt target, the
# architecture, the folder it installs into, and a file that tells the install
# is whole.
TARGETS = {
    "win32": [("windows", "desktop", "win64_msvc2022_64", "msvc2022_64", "bin/qmltestrunner.exe")],
    "darwin": [("mac", "desktop", "clang_64", "macos", "bin/qmltestrunner")],
    "linux": [
        ("all_os", "android", "android_x86_64", "android_x86_64", "bin/qt-cmake"),
        ("linux", "desktop", "linux_gcc_64", "gcc_64", "bin/androiddeployqt"),
    ],
}

if sys.platform not in TARGETS:
    sys.exit(0)

root = Path(os.environ.get("MISE_PROJECT_ROOT") or Path(__file__).resolve().parents[1])
cache = root / ".qt"
# Any other Qt version in .qt goes.
if cache.is_dir():
    for entry in cache.iterdir():
        if entry.name != QT:
            shutil.rmtree(entry) if entry.is_dir() else entry.unlink()
cache.mkdir(exist_ok=True)
for host, target, arch, folder, whole in TARGETS[sys.platform]:
    if (cache / QT / folder / whole).is_file():
        continue
    shutil.rmtree(cache / QT / folder, ignore_errors=True)
    # Run inside .qt, where aqt's own log stays out of the checkout.
    subprocess.run(
        ["aqt", "install-qt", host, target, QT, arch, "--outputdir", str(cache), "--archives", *ARCHIVES],
        check=True,
        cwd=cache,
    )
