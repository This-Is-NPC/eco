#!/usr/bin/env python3
"""Install the Qt that eco-window builds and runs with on Windows and macOS:
Qt `QT`, its base and declarative modules (everything the overlay imports),
for MSVC 2022 64-bit into .qt/<QT>/msvc2022_64, or for macOS into
.qt/<QT>/macos, in the checkout, through aqt, which mise pins. Removes any
other version there. Idempotent: a Qt already installed is left alone. On
Linux it does nothing: eco-window builds with the system's Qt."""

import os
import shutil
import subprocess
import sys
from pathlib import Path

QT = "6.11.2"
# The aqt host, architecture, the folder it installs into, and a file that
# tells the install is whole, per platform.
TARGETS = {
    "win32": ("windows", "win64_msvc2022_64", "msvc2022_64", "bin/qmltestrunner.exe"),
    "darwin": ("mac", "clang_64", "macos", "bin/qmltestrunner"),
}

if sys.platform not in TARGETS:
    sys.exit(0)
host, arch, folder, whole = TARGETS[sys.platform]

root = Path(os.environ.get("MISE_PROJECT_ROOT") or Path(__file__).resolve().parents[1])
cache = root / ".qt"
if (cache / QT / folder / whole).is_file():
    sys.exit(0)
if cache.exists():
    shutil.rmtree(cache)
subprocess.run(
    ["aqt", "install-qt", host, "desktop", QT, arch, "--outputdir", str(cache), "--archives", "qtbase", "qtdeclarative"],
    check=True,
)
