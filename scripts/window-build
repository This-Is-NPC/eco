#!/usr/bin/env python3
"""Build eco-window, the Qt 6 program that runs the overlay, into target/window
(release, warnings as errors). Incremental. Run from the root of the tree to
build, as the PKGBUILD runs it in its own copy.

On Linux it builds with Ninja, the system's compiler and the system's Qt. On
Windows it builds with MSVC, which CMake finds through its Visual Studio
generator, and the Qt scripts/qt-install put under .qt, then copies beside
target/window/eco-window.exe the Qt libraries and QML modules it runs with
(the offscreen platform too, for the tests)."""

import subprocess
import sys
from pathlib import Path

BUILD = Path("target/window")


def run(*command):
    subprocess.run(command, check=True)


if sys.platform == "win32":
    found = sorted(Path(".qt").glob("*/msvc2022_64"))
    if len(found) != 1:
        sys.exit("window-build: no Qt under .qt; run `mise run qt:install`")
    qt = found[0].resolve()
    run(
        "cmake", "-S", "window", "-B", str(BUILD), "-G", "Visual Studio 17 2022", "-A", "x64",
        f"-DCMAKE_PREFIX_PATH={qt}", f"-DCMAKE_RUNTIME_OUTPUT_DIRECTORY_RELEASE={BUILD.resolve()}",
    )
    run("cmake", "--build", str(BUILD), "--config", "Release")
    run(
        str(qt / "bin" / "windeployqt.exe"), "--release", "--verbose", "0", "--no-translations",
        "--no-system-d3d-compiler", "--no-system-dxc-compiler", "--no-opengl-sw", "--no-compiler-runtime",
        "--include-plugins", "qoffscreen", "--qmldir", "overlay",
        str(BUILD / "eco-window.exe"),
    )
else:
    subprocess.run(
        ["cmake", "-S", "window", "-B", str(BUILD), "-G", "Ninja", "-DCMAKE_BUILD_TYPE=Release"],
        check=True, stdout=subprocess.DEVNULL,
    )
    run("cmake", "--build", str(BUILD))
