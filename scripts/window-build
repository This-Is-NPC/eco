#!/usr/bin/env python3
"""Build eco-window, the Qt 6 program that runs the overlay, into target/window,
on macOS as the bundle eco.app in target/window.noindex (release, warnings as
errors). Incremental. Run from the root of the tree to
build, as the PKGBUILD runs it in its own copy.

On Linux it builds with Ninja, the system's compiler and the system's Qt; on
macOS with Ninja, the system's compiler and the Qt scripts/qt-install put under
.qt, which the program finds by the path CMake writes into it. On
Windows it builds with MSVC, which CMake finds through its Visual Studio
generator, and the Qt scripts/qt-install put under .qt, in target/window-msvc,
then copies beside target/window/eco-window.exe the Qt libraries and QML
modules it runs with (the offscreen platform and QtTest too, for the tests), so that
target/window holds the program and its runtime alone, as scripts/package
ships it."""

import subprocess
import sys
from pathlib import Path

# On macOS a folder Spotlight skips (.noindex), so Launchpad lists only the
# installed eco.app, not this one too.
BUILD = Path("target/window.noindex" if sys.platform == "darwin" else "target/window")


def run(*command):
    subprocess.run(command, check=True)


if sys.platform == "win32":
    found = sorted(Path(".qt").glob("*/msvc2022_64"))
    if len(found) != 1:
        sys.exit("window-build: no Qt under .qt; run `mise run qt:install`")
    qt = found[0].resolve()
    run(
        "cmake", "-S", "window", "-B", "target/window-msvc", "-G", "Visual Studio 17 2022", "-A", "x64",
        f"-DCMAKE_PREFIX_PATH={qt}", f"-DCMAKE_RUNTIME_OUTPUT_DIRECTORY_RELEASE={BUILD.resolve()}",
    )
    run("cmake", "--build", "target/window-msvc", "--config", "Release")
    run(
        str(qt / "bin" / "windeployqt.exe"), "--release", "--verbose", "0", "--no-translations",
        "--no-system-d3d-compiler", "--no-system-dxc-compiler", "--no-opengl-sw", "--no-compiler-runtime",
        "--include-plugins", "qoffscreen", "--qmldir", "overlay", "--qmldir", "tests/window",
        str(BUILD / "eco-window.exe"),
    )
else:
    prefix = []
    if sys.platform == "darwin":
        found = sorted(Path(".qt").glob("*/macos"))
        if len(found) != 1:
            sys.exit("window-build: no Qt under .qt; run `mise run qt:install`")
        prefix = [f"-DCMAKE_PREFIX_PATH={found[0].resolve()}"]
    subprocess.run(
        ["cmake", "-S", "window", "-B", str(BUILD), "-G", "Ninja", "-DCMAKE_BUILD_TYPE=Release", *prefix],
        check=True, stdout=subprocess.DEVNULL,
    )
    run("cmake", "--build", str(BUILD))
