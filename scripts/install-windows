#!/usr/bin/env python3
"""Install the release build of eco from this checkout on Windows, for the
machine: install.ps1, the installer of a release, run on the MSI and
SHA256SUMS `mise run package` wrote into dist. It removes an older per-user
install, stops a running eco, installs the MSI in C:\\Program Files\\eco for
every user (Windows asks for administrator rights) and starts again a daemon
that was running. Idempotent: each install replaces the last; sessions,
config and models stay."""

import os
import sys
from pathlib import Path

if sys.platform != "win32":
    sys.exit("install:windows installs eco on Windows; on Linux run `mise run install`")

sys.dont_write_bytecode = True
root = Path(os.environ.get("MISE_PROJECT_ROOT") or Path.cwd())
sys.path.insert(0, str(root / "scripts/lib"))
import windows  # noqa: E402

windows.installer(root, BASE_URL=(root / "dist").as_uri())
