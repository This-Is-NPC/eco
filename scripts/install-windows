#!/usr/bin/env python3
"""Install the release build of eco from this checkout on Windows, for the
user who runs it: install.ps1, the installer of a release, run on the zip and
SHA256SUMS `mise run package` wrote into dist. It stops a running eco, puts
the zip's eco folder in %LOCALAPPDATA%\\Programs\\eco, its bin on the user's
PATH, runs `eco setup` and starts again a daemon that was running.
Idempotent: each install replaces the last; sessions, config and models
stay."""

import os
import sys
from pathlib import Path

if sys.platform != "win32":
    sys.exit("install:windows installs eco on Windows; on Linux run `mise run install`")

sys.dont_write_bytecode = True
root = Path(os.environ.get("MISE_PROJECT_ROOT") or Path.cwd())
sys.path.insert(0, str(root / "scripts/lib"))
import windows  # noqa: E402

windows.installer(root, BASE_URL=(root / "dist").as_uri())
