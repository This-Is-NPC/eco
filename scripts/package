#!/usr/bin/env python3
"""Build the release package of eco for the machine it runs on. Run from the
root of the tree.

On Linux: the Arch package of the committed HEAD into target/arch/pkg. Needs
makepkg; not as root. The release's SHA256SUMS, which install.sh checks it
against, is written by the release workflow over every package it attaches.

On Windows: dist/eco-<version>-windows-x86_64.msi of the working tree, the
per-machine installer of one folder eco/ laid out as the daemon looks for what
it ships (docs/design.md §13), staged by scripts/lib/windows.py: bin/eco.exe,
the window program and its Qt runtime in lib/eco (built by
scripts/window-build, the icon inside it), the overlay in share/eco/overlay,
the icon eco's notifications show in share/eco/eco.ico, the models in
share/eco/models, the licences and README.txt. `wix build` (WiX, pinned by
mise) packs it. Beside it, dist/SHA256SUMS names the MSI in the release's
format, so install.ps1 installs it from dist as it does from a release
(scripts/install-windows).

On macOS: dist/eco-<version>-macos-aarch64.tar.gz of the working tree, one
folder eco/ laid out the same way: bin/eco, the window program as
lib/eco/eco-window.app with the Qt it runs with inside (macdeployqt, from the
Qt under .qt), the overlay in share/eco/overlay, the licence and README.txt.
Every program in it is signed ad hoc, since macdeployqt rewrites them. Beside
it, dist/SHA256SUMS names it, so install-macos.sh installs it from dist as it
does from a release (scripts/install-macos)."""

import hashlib
import os
import shutil
import subprocess
import sys
import tarfile
import tomllib
from pathlib import Path

root = Path(os.environ.get("MISE_PROJECT_ROOT") or Path.cwd())

if sys.platform == "win32":
    sys.dont_write_bytecode = True
    sys.path.insert(0, str(root / "scripts/lib"))
    import windows

    windows.build(root)
    version = tomllib.loads((root / "Cargo.toml").read_text())["package"]["version"]
    staging = root / "target/windows"
    eco = staging / "eco"
    windows.stage(root, eco)
    installer = root / "dist" / f"eco-{version}-windows-x86_64.msi"
    installer.parent.mkdir(exist_ok=True)
    windows.msi(root, eco, version, installer)
    digest = hashlib.sha256(installer.read_bytes()).hexdigest()
    (installer.parent / "SHA256SUMS").write_text(f"{digest}  {installer.name}\n", newline="\n")
    print(f"{digest}  {installer.name}")
    print(f"{installer}: {installer.stat().st_size} bytes")
elif sys.platform == "darwin":
    app = root / "target/window/eco-window.app"
    if not app.is_dir():
        sys.exit("package: no target/window/eco-window.app; run `mise run window:build`")
    qt = sorted((root / ".qt").glob("*/macos"))
    if len(qt) != 1:
        sys.exit("package: no Qt under .qt; run `mise run qt:install`")
    subprocess.run(["cargo", "build", "--release", "--locked", "--quiet"], cwd=root, check=True)
    version = tomllib.loads((root / "Cargo.toml").read_text())["package"]["version"]
    staging = root / "target/macos"
    eco = staging / "eco"
    shutil.rmtree(staging, ignore_errors=True)
    (eco / "bin").mkdir(parents=True)
    shutil.copy2(root / "target/release/eco", eco / "bin/eco")
    window = eco / "lib/eco/eco-window.app"
    shutil.copytree(app, window, symlinks=True)
    subprocess.run(
        [qt[0] / "bin/macdeployqt", window, f"-qmldir={root / 'overlay'}", "-always-overwrite", "-verbose=0"],
        check=True,
    )
    for program in (window, eco / "bin/eco"):
        subprocess.run(["codesign", "--force", "--deep", "--sign", "-", program], check=True)
    shutil.copytree(root / "overlay", eco / "share/eco/overlay")
    shutil.copy2(root / "LICENSE", eco / "LICENSE")
    shutil.copy2(root / "packaging/macos/README.txt", eco / "README.txt")
    archive = root / "dist" / f"eco-{version}-macos-aarch64.tar.gz"
    archive.parent.mkdir(exist_ok=True)
    with tarfile.open(archive, "w:gz") as tar:
        tar.add(eco, arcname="eco")
    digest = hashlib.sha256(archive.read_bytes()).hexdigest()
    (archive.parent / "SHA256SUMS").write_text(f"{digest}  {archive.name}\n")
    files = sum(1 for path in eco.rglob("*") if path.is_file())
    # The staged folder holds a second eco-window.app, which Launchpad would list.
    shutil.rmtree(staging)
    print(f"{digest}  {archive.name}")
    print(f"{archive}: {files} files, {archive.stat().st_size} bytes")
else:
    out = root / "target/arch"
    shutil.rmtree(out, ignore_errors=True)
    for directory in ("build", "pkg", "src", "log"):
        (out / directory).mkdir(parents=True)
    # -d: the runtime dependencies are the target machine's, not the builder's.
    subprocess.run(
        ["makepkg", "-f", "-d", "--noconfirm"],
        cwd=root / "packaging/arch",
        env=os.environ | {
            "ECO_TREE": str(root),
            "BUILDDIR": str(out / "build"),
            "PKGDEST": str(out / "pkg"),
            "SRCDEST": str(out / "src"),
            "LOGDEST": str(out / "log"),
        },
        check=True,
    )
    packages = sorted((out / "pkg").glob("eco-[0-9]*.pkg.tar.zst"))
    if not packages:
        sys.exit("package: makepkg wrote no eco package")
    for package in packages:
        print(package)
