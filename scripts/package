#!/usr/bin/env python3
"""Build the release package of eco for the machine it runs on. Run from the
root of the tree.

On Linux: the Arch package of the committed HEAD into target/arch/pkg. Needs
makepkg; not as root. The release's SHA256SUMS, which install.sh checks it
against, is written by the release workflow over every package it attaches.

On Windows: dist/eco-<version>-windows-x86_64.zip of the working tree, one
folder eco/ laid out as the daemon looks for what it ships (docs/design.md
§13), staged by scripts/lib/windows.py: bin/eco.exe, the window program and
its Qt runtime in lib/eco (built by scripts/window-build, the icon inside it)
beside eco-launch.exe, the Start menu entry's program,
the overlay in share/eco/overlay, the icon eco's notifications show in
share/eco/eco.ico, the licence and README.txt. Beside it, dist/SHA256SUMS names the zip in the release's format, so install.ps1 installs
it from dist as it does from a release (scripts/install-windows)."""

import hashlib
import os
import shutil
import subprocess
import sys
import tomllib
import zipfile
from pathlib import Path

root = Path(os.environ.get("MISE_PROJECT_ROOT") or Path.cwd())

if sys.platform == "win32":
    sys.dont_write_bytecode = True
    sys.path.insert(0, str(root / "scripts/lib"))
    import windows

    windows.build(root)
    version = tomllib.loads((root / "Cargo.toml").read_text())["package"]["version"]
    staging = root / "target/windows"
    eco = staging / "eco"
    windows.stage(root, eco)
    archive = root / "dist" / f"eco-{version}-windows-x86_64.zip"
    archive.parent.mkdir(exist_ok=True)
    files = sorted(path for path in eco.rglob("*") if path.is_file())
    with zipfile.ZipFile(archive, "w", zipfile.ZIP_DEFLATED, strict_timestamps=False) as zip:
        for path in files:
            zip.write(path, path.relative_to(staging).as_posix())
    digest = hashlib.sha256(archive.read_bytes()).hexdigest()
    (archive.parent / "SHA256SUMS").write_text(f"{digest}  {archive.name}\n", newline="\n")
    print(f"{digest}  {archive.name}")
    print(f"{archive}: {len(files)} files, {archive.stat().st_size} bytes")
else:
    out = root / "target/arch"
    shutil.rmtree(out, ignore_errors=True)
    for directory in ("build", "pkg", "src", "log"):
        (out / directory).mkdir(parents=True)
    # -d: the runtime dependencies are the target machine's, not the builder's.
    subprocess.run(
        ["makepkg", "-f", "-d", "--noconfirm"],
        cwd=root / "packaging/arch",
        env=os.environ | {
            "ECO_TREE": str(root),
            "BUILDDIR": str(out / "build"),
            "PKGDEST": str(out / "pkg"),
            "SRCDEST": str(out / "src"),
            "LOGDEST": str(out / "log"),
        },
        check=True,
    )
    packages = sorted((out / "pkg").glob("eco-[0-9]*.pkg.tar.zst"))
    if not packages:
        sys.exit("package: makepkg wrote no eco package")
    for package in packages:
        print(package)
