#!/usr/bin/env bash
# Fail when docs/cli.md is not what scripts/cli-gen writes from the eco binary.
set -euo pipefail

page="$(mktemp)"
trap 'rm -f "$page" "$page.tmp"' EXIT
scripts/cli-gen "$page"
if ! cmp -s docs/cli.md "$page"; then
  echo "cli-check: docs/cli.md is stale (run mise run cli:gen)" >&2
  exit 1
fi
