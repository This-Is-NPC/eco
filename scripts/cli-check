#!/usr/bin/env python3
"""Fail when docs/cli.md is not what scripts/cli-gen writes from the eco binary."""

import subprocess
import sys
import tempfile
from pathlib import Path

with tempfile.TemporaryDirectory() as scratch:
    page = Path(scratch) / "cli.md"
    subprocess.run([sys.executable, "scripts/cli-gen", str(page)], check=True)
    if page.read_bytes() != Path("docs/cli.md").read_bytes():
        sys.exit("cli-check: docs/cli.md is stale (run mise run cli:gen)")
