#!/usr/bin/env python3
"""Install the Android SDK packages the Android build and its emulator use
into .android-sdk in the checkout, through the command-line tools mise pins:
platform tools, platform `PLATFORM`, build tools `BUILD_TOOLS`, NDK `NDK`,
the emulator and its x86_64 system image, then the `AVD` virtual device under
.android-sdk/avd. Idempotent: an installed package or an existing device is
left alone; packages of other versions are removed."""

import os
import subprocess
import sys
from pathlib import Path

PLATFORM = "android-36"
BUILD_TOOLS = "36.0.0"
NDK = "29.0.14206865"
IMAGE = f"system-images;{PLATFORM};google_apis;x86_64"
AVD = "eco"
PACKAGES = [
    "platform-tools",
    f"platforms;{PLATFORM}",
    f"build-tools;{BUILD_TOOLS}",
    f"ndk;{NDK}",
    "emulator",
    IMAGE,
]
# The folder each versioned package installs into, by its kind.
VERSIONED = {"platforms": PLATFORM, "build-tools": BUILD_TOOLS, "ndk": NDK}

if not sys.platform.startswith("linux"):
    sys.exit("android:setup runs on Linux, where Android is built")

root = Path(os.environ.get("MISE_PROJECT_ROOT") or Path(__file__).resolve().parents[1])
sdk = root / ".android-sdk"
avd_home = sdk / "avd"
avd_home.mkdir(parents=True, exist_ok=True)
# avdmanager takes its SDK from where its tools live, not from ANDROID_HOME:
# a tools directory under .android-sdk points it there.
env = {
    **os.environ,
    "ANDROID_HOME": str(sdk),
    "ANDROID_AVD_HOME": str(avd_home),
    "AVDMANAGER_OPTS": f"-Dcom.android.sdkmanager.toolsdir={sdk / 'cmdline-tools' / 'latest'}",
}


def sdkmanager(*args, **kwargs):
    return subprocess.run(["sdkmanager", f"--sdk_root={sdk}", *args], env=env, check=True, **kwargs)


def listed(output):
    """The installed package names in `--list_installed` output: the first
    column of the indented rows under its header, with `/` written as the `;`
    installs take."""
    names, table = [], False
    for line in output.splitlines():
        words = line.split()
        if not line.startswith(" "):
            table = line.startswith("Installed packages")
        elif table and words and words[0] not in ("Path", "(no") and not words[0].startswith("-"):
            names.append(words[0].replace("/", ";"))
    return names


installed = listed(sdkmanager("--list_installed", capture_output=True, text=True).stdout)
stale = [name for name in installed if name.split(";")[0] in VERSIONED and name not in PACKAGES]
if stale:
    sdkmanager("--uninstall", *stale)
missing = [name for name in PACKAGES if name not in installed]
if missing:
    sdkmanager("--install", *missing)

avds = subprocess.run(["avdmanager", "list", "avd", "--compact"], env=env, check=True, capture_output=True, text=True).stdout.split()
if AVD not in avds:
    # A phone with the stock hardware profile; "no" declines a custom one.
    subprocess.run(
        ["avdmanager", "create", "avd", "--name", AVD, "--package", IMAGE, "--device", "pixel_8"],
        env=env,
        check=True,
        input="no\n",
        text=True,
    )
