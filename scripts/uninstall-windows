#!/usr/bin/env python3
"""Take eco off Windows: stop it, then remove what scripts/install-windows put
there, the eco folder in %LOCALAPPDATA%\\Programs, its PATH entry, the
Start-menu shortcut and the login script an older eco wrote. --delete-everything also deletes
%APPDATA%\\eco and %LOCALAPPDATA%\\eco (config, sessions, people, models,
log); --keep-data keeps them. With neither, it asks."""

import os
import sys
from pathlib import Path

if sys.platform != "win32":
    sys.exit("uninstall:windows takes eco off Windows; on Linux run `mise run uninstall`")

sys.dont_write_bytecode = True
# Each line before the output of the programs it runs.
sys.stdout.reconfigure(line_buffering=True)
root = Path(os.environ.get("MISE_PROJECT_ROOT") or Path.cwd())
sys.path.insert(0, str(root / "scripts/lib"))
import windows  # noqa: E402

keep = os.environ.get("usage_keep_data") == "true"
delete = os.environ.get("usage_delete_everything") == "true"
if keep and delete:
    sys.exit("uninstall:windows: give --keep-data or --delete-everything, not both")
if not keep and not delete:
    print("1) uninstall eco, keep sessions, config and models")
    print("2) uninstall and delete everything")
    answer = input("Choose 1 or 2: ").strip()
    if answer == "2":
        delete = input("Type delete to delete your sessions, config and models: ").strip() == "delete"
        if not delete:
            sys.exit("nothing removed")
    elif answer != "1":
        sys.exit("nothing removed")

eco = windows.install_dir()
data = [Path(os.environ["APPDATA"]) / "eco", Path(os.environ["LOCALAPPDATA"]) / "eco"]
programs = Path(os.environ["APPDATA"]) / r"Microsoft\Windows\Start Menu\Programs"
installed = eco / "bin/eco.exe"
built = root / "target/release/eco.exe"
for exe in (installed, built):
    if exe.exists():
        windows.stop(exe, eco)
        break
for path in (eco, *(data if delete else [])):
    if path.exists():
        windows.remove(path)
        print(f"removed {path}")
for entry in (programs / r"Startup\eco.cmd", programs / "eco.lnk"):
    if entry.exists():
        entry.unlink()
        print(f"removed {entry}")
if windows.remove_from_user_path(eco / "bin"):
    print(f"removed {eco / 'bin'} from your PATH")
if not delete:
    for path in data:
        if path.exists():
            print(f"kept {path}")
