#!/usr/bin/env python3
"""Take eco off Windows through install.ps1 (ECO_UNINSTALL): stop it, then
remove the MSI install in C:\\Program Files\\eco and, if one is there, the
per-user install of eco 0.9 and earlier (its folder in
%LOCALAPPDATA%\\Programs, PATH entry, Start-menu shortcut, notification key
and login script).
--delete-everything also deletes %APPDATA%\\eco and %LOCALAPPDATA%\\eco
(config, sessions, people, models, log); --keep-data keeps them. With
neither, it asks."""

import os
import sys
from pathlib import Path

if sys.platform != "win32":
    sys.exit("uninstall:windows takes eco off Windows; on Linux run `mise run uninstall`")

sys.dont_write_bytecode = True
root = Path(os.environ.get("MISE_PROJECT_ROOT") or Path.cwd())
sys.path.insert(0, str(root / "scripts/lib"))
import windows  # noqa: E402

keep = os.environ.get("usage_keep_data") == "true"
delete = os.environ.get("usage_delete_everything") == "true"
if keep and delete:
    sys.exit("uninstall:windows: give --keep-data or --delete-everything, not both")
if not keep and not delete:
    print("1) uninstall eco, keep sessions, config and models")
    print("2) uninstall and delete everything")
    answer = input("Choose 1 or 2: ").strip()
    if answer == "2":
        delete = input("Type delete to delete your sessions, config and models: ").strip() == "delete"
        if not delete:
            sys.exit("nothing removed")
    elif answer != "1":
        sys.exit("nothing removed")

windows.installer(root, ECO_UNINSTALL="everything" if delete else "keep")
