            w.do("return d.click('title=\"gemini-flash\"')")
            w.do(
                "const card = d.find('title=\"gemini-flash\"'); let page = card.parent;"
                " while (d.kind(page) !== 'ScrollPage') page = page.parent;"
                " page.contentY = Math.min(card.mapToItem(page.contentItem, 0, 0).y - 12, page.contentHeight - page.height)",
                0.4,
            )
            shots.take("41-settings-model", "settings")
            w.do("return d.click('title=\"gemini-flash\"')")
        elif tab == "answers":
            scroll_end("settings.contentItem")
            shots.take("44-settings-answers-end", "settings")
        elif tab == "skills":
            w.do("return d.click('title=\"reply\"')")
            shots.take("46-settings-skill", "settings")
            w.do("return d.click('title=\"reply\"')")
    # A name that cannot be saved, then closing with it unsaved.
    w.do("Eco.openConfigAt(4)")
    w.do("return d.click('title=\"minutes\"')")
    w.do("return d.type('label=\"NAME\" value=\"minutes\"', 'weekly minutes')")
    w.do("settings.contentItem.forceActiveFocus()")
    shots.take("50-settings-errors", "settings")
    w.do("settings.attemptClose()")
    shots.take("51-settings-unsaved", "settings")
    w.do("settings.data.filter(o => d.kind(o) === 'ConfirmDialog').forEach(o => o.close()); settings.reset()")
    w.do("Eco.toggleConfig()")

    # A change to a hook and a context file another program sent, held for the user.
    w.do(f"Eco.handle({q(PENDING)})")
    w.do("d.blur()")
    shots.take("52-settings-pending")
    w.do(f"Eco.handle({q(dict(PENDING, hooks=[], files=[], models=[]))})")

    # The start screen once the daemon is gone.
    w.do("Eco.leaveSession(); Eco.go('start')")
    stop()
    shots.until("!Eco.connected", "the window to lose the daemon")
    shots.take("02-disconnected", offline=True)


def main():
    if not shutil.which("quickshell"):
        fail("quickshell is not installed")
    subprocess.run(["cargo", "build", "--locked", "--quiet"], cwd=ROOT, check=True)
    lock = open(f"{HOME}.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        fail(f"another run holds {HOME}")
    home = HOME
    shutil.rmtree(home, ignore_errors=True)
    home.mkdir(mode=0o700)
    env = environment(home)
    user_socket = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}") / "eco.sock"
    if Path(env["XDG_RUNTIME_DIR"]) / "eco.sock" == user_socket:
        fail("refusing to run against the user's socket")
    daemon = window = None
    try:
        seed(home)
        daemon = start_daemon(home, env)
        window = Window(home, env)
        OUT.mkdir(parents=True, exist_ok=True)
        shots = Shots(window, OUT)
        scenes(window, shots, lambda: subprocess.run([str(ECO), "stop"], env=env, capture_output=True))
        # A picture no scene takes any more is stale.
        for old in OUT.glob("[0-9][0-9]-*.png"):
            if old not in shots.taken:
                old.unlink()
    finally:
        if window:
            window.close()
        if daemon:
            subprocess.run([str(ECO), "stop"], env=env, capture_output=True)
            try:
                daemon.wait(5)
            except subprocess.TimeoutExpired:
                os.killpg(daemon.pid, signal.SIGKILL)
        shutil.rmtree(home, ignore_errors=True)


if __name__ == "__main__":
    main()
