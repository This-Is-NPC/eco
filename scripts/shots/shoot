def fail(message):
    sys.exit(f"shots: {message}")


def models_dir():
    """The eco data directory's models, which `mise run setup` downloads."""
    data = os.environ.get("XDG_DATA_HOME") or str(Path.home() / ".local" / "share")
    return Path(data) / "eco" / "models"


def write_replay(path):
    """A synthetic 16 kHz mono WAV for --replay, ten minutes long: a hum in
    bursts of uneven length, so the input traces move. No voice: nothing in it
    is speech to transcribe."""
    rate, pattern = 16000, bytearray()
    for start, length in ((0.0, 1.6), (2.1, 0.7), (3.3, 2.4), (6.4, 1.1)):
        silence = int(start * rate) - len(pattern) // 2
        pattern += bytes(2 * silence)
        for i in range(int(length * rate)):
            t = i / rate
            envelope = math.sin(math.pi * t / length) * (0.55 + 0.45 * math.sin(2 * math.pi * 3.1 * t) ** 2)
            tone = math.sin(2 * math.pi * 180 * t) + 0.4 * math.sin(2 * math.pi * 270 * t)
            pattern += struct.pack("<h", int(5000 * envelope * tone))
    pattern += bytes(2 * int(0.9 * rate))
    with wave.open(str(path), "wb") as out:
        out.setnchannels(1)
        out.setsampwidth(2)
        out.setframerate(rate)
        out.writeframes(bytes(pattern) * (600 * rate * 2 // len(pattern)))


def environment(home):
    """The environment every process here runs in: its own home and XDG
    directories, offscreen Qt, UTC, and none of the user's keys or display."""
    env = {
        key: value
        for key, value in os.environ.items()
        if not key.endswith("_API_KEY")
        and key not in ("WAYLAND_DISPLAY", "DISPLAY", "HYPRLAND_INSTANCE_SIGNATURE", "QT_IM_MODULE", "QT_SCALE_FACTOR")
    }
    env.update(
        HOME=str(home),
        XDG_RUNTIME_DIR=str(home / "run"),
        XDG_DATA_HOME=str(home / ".local/share"),
        XDG_CONFIG_HOME=str(home / ".config"),
        XDG_STATE_HOME=str(home / ".local/state"),
        XDG_CACHE_HOME=str(home / ".cache"),
        TZ="UTC",
        LANG="en_US.UTF-8",
        LC_ALL="en_US.UTF-8",
        QT_QPA_PLATFORM="offscreen",
        QT_QPA_PLATFORMTHEME="",
        QT_FONT_DPI="96",
        ECO_WINDOW="1",
        # The daemon builds every provider when it starts, so the config's key
        # variables must be set; nothing is sent with them.
        OPENROUTER_API_KEY="placeholder-never-sent",
        DEEPGRAM_API_KEY="placeholder-never-sent",
    )
    return env


def seed(home):
    for directory in ("run", ".local/share/eco/models", ".config/eco", ".local/state", ".cache"):
        (home / directory).mkdir(parents=True, exist_ok=True)
    os.chmod(home / "run", 0o700)
    vad = models_dir() / "silero_vad.onnx"
    if not vad.is_file():
        fail(f"missing {vad}; run `mise run setup`")
    shutil.copy(vad, home / ".local/share/eco/models")
    shutil.copy(FIXTURES / "config.toml", home / ".config/eco/config.toml")
    for kind in ("sessions", "people"):
        shutil.copytree(FIXTURES / kind, home / ".local/share/eco" / kind)
    shutil.copytree(FIXTURES / "home", home, dirs_exist_ok=True)
    # When the transcript was written, as its import is dated (the window runs in UTC).
    retro = calendar.timegm((2026, 9, 30, 9, 15, 0))
    os.utime(home / "recordings" / "sprint-retro.vtt", (retro, retro))
    write_replay(home / "replay.wav")
    # The overlay copy, with the driver beside shell.qml and declared in it.
    shutil.copytree(ROOT / "overlay", home / "overlay")
    shutil.copy(HERE / "Drive.qml", home / "overlay")
    shell = home / "overlay" / "shell.qml"
    anchor = "  OverlayPanel { id: overlay }\n"
    text = shell.read_text()
    if anchor not in text:
        fail("overlay/shell.qml no longer declares `OverlayPanel { id: overlay }`; update the driver's anchor")
    shell.write_text(text.replace(anchor, anchor + "  Drive { overlay: overlay; settings: settings }\n", 1))


def answering(path):
    try:
        with socket.socket(socket.AF_UNIX) as client:
            client.connect(str(path))
        return True
    except OSError:
        return False


def start_daemon(home, env):
    sock = home / "run" / "eco.sock"
    log = open(home / "daemon.log", "w")
    daemon = subprocess.Popen(
        [str(ECO), "daemon", "--headless", "--replay", str(home / "replay.wav")],
        env=env, stdout=log, stderr=subprocess.STDOUT, start_new_session=True,
    )
    for _ in range(100):
        if daemon.poll() is not None:
            fail("the daemon refused to start:\n" + (home / "daemon.log").read_text())
        if answering(sock):
            return daemon
        time.sleep(0.1)
    fail("the daemon did not open " + str(sock))


class Window:
    """The overlay copy, offscreen, and the driver inside it."""

    def __init__(self, home, env):
        self.env = env
        self.log = open(home / "overlay.log", "w")
        self.process = subprocess.Popen(
            ["quickshell", "--path", str(home / "overlay")],
            env=env, stdout=self.log, stderr=subprocess.STDOUT, start_new_session=True,
        )
        for _ in range(100):
            if self.process.poll() is not None:
                fail("the overlay exited:\n" + (home / "overlay.log").read_text())
            if self.js("return Eco.connected", quiet=True) == "true":
                return
            time.sleep(0.1)
        fail("the overlay did not connect to the daemon")

    def js(self, code, quiet=False):
        done = subprocess.run(
            ["quickshell", "ipc", "--pid", str(self.process.pid), "call", "drive", "run", code],
            env=self.env, capture_output=True, text=True,
        )
        answer = done.stdout.strip()
        if not quiet and (done.returncode != 0 or answer.startswith("error:")):
            fail(f"driver: {answer or done.stderr.strip()}\n  in: {code}")
        return answer

    def do(self, code, wait=0.6):
        answer = self.js(code)
        time.sleep(wait)
        return answer

    def close(self):
        self.process.terminate()
        try:
            self.process.wait(5)
        except subprocess.TimeoutExpired:
            self.process.kill()


def pixels(path):
    """The rows of an 8-bit RGB(A) PNG, as Qt writes it, unfiltered."""
    data = path.read_bytes()
    chunks, at = {}, 8
    while at < len(data):
        length, kind = struct.unpack(">I4s", data[at : at + 8])
        chunks.setdefault(kind, []).append(data[at + 8 : at + 8 + length])
        at += 12 + length
    width, height, depth, color = struct.unpack(">IIBB", chunks[b"IHDR"][0][:10])
    if depth != 8 or color not in (2, 6):
        fail(f"{path.name}: unexpected PNG format")
    step = 4 if color == 6 else 3
    raw = zlib.decompress(b"".join(chunks[b"IDAT"]))
    stride = width * step
    rows, previous = [], bytearray(stride)
    for y in range(height):
        kind, line = raw[y * (stride + 1)], bytearray(raw[y * (stride + 1) + 1 : (y + 1) * (stride + 1)])
        for x in range(stride):
            left = line[x - step] if x >= step else 0
            up, corner = previous[x], previous[x - step] if x >= step else 0
            if kind == 1:
                line[x] = (line[x] + left) & 255
            elif kind == 2:
                line[x] = (line[x] + up) & 255
            elif kind == 3:
                line[x] = (line[x] + (left + up) // 2) & 255
            elif kind == 4:
                p = left + up - corner
                pa, pb, pc = abs(p - left), abs(p - up), abs(p - corner)
                line[x] = (line[x] + (left if pa <= pb and pa <= pc else up if pb <= pc else corner)) & 255
        rows.append(bytes(line))
        previous = line
    return width, height, step, rows


def refuse_flat(path):
    """A frame of one colour, or nearly, is a window that drew nothing."""
    width, height, step, rows = pixels(path)
    seen = set()
    for row in rows[:: max(1, height // 120)]:
        for x in range(0, width * step, step * max(1, width // 120)):
            seen.add(row[x : x + 3])
    if len(seen) < 8:
        fail(f"{path.name} is flat ({len(seen)} colours): the window drew nothing")


class Shots:
    def __init__(self, window, out):
        self.window, self.out, self.taken = window, out, []

    def until(self, condition, what):
        """Wait for a JS condition on the window to hold, or fail saying `what`."""
        for _ in range(50):
            if self.window.js(f"return !!({condition})") == "true":
                return
            time.sleep(0.1)
        fail(f"timed out waiting for {what}")

    def size(self, width, height, which="overlay"):
        self.window.do(f"return d.size({json.dumps(which)}, {width}, {height})", 0.8)

    def take(self, name, which="overlay", offline=False):
        """Save a picture of a window, refusing one taken while the window
        is offline (unless that is the picture) or shows an error, and one
        that drew nothing."""
        w = self.window
        state = json.loads(w.js("return { connected: Eco.connected, error: Eco.messageIsError, message: Eco.message }"))
        if state["connected"] == offline:
            fail(f"{name}: the overlay is {'still connected' if offline else 'offline'}")
        if state["error"]:
            fail(f"{name}: the window shows an error: {state['message']}")
        path = self.out / f"{name}.png"
        path.unlink(missing_ok=True)
        # What moves on a change settles within 300 ms.
        time.sleep(0.6)
        size = w.js(f"return d.shot({json.dumps(str(path))}, {json.dumps(which)})")
        # Saved once its size stops growing.
        written = -1
        for _ in range(50):
            time.sleep(0.1)
            now = path.stat().st_size if path.exists() else 0
            if now > 0 and now == written:
                break
            written = now
        else:
            fail(f"{name}: no picture was saved ({size})")
        refuse_flat(path)
        self.taken.append(path)
        print(f"{path.name}  {size}")


